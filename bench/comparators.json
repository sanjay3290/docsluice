      "formats": ["pdf"]
    },
    "pdfjs-dist": {
      "package": "pdfjs-dist",
      "version": "6.4.299",
      "license": "Apache-2.0",
      "source": "https://github.com/mozilla/pdf.js",
      "formats": ["pdf"]
    }
  },
  "cases": [
    {
      "format": "docx",
      "fixture": "benchmark-5mb.docx",
      "expectedUnits": 10000,
      "marker": "(?<![A-Za-z0-9])P[0-9]{5}(?![A-Za-z0-9])",
      "markerPrefix": "P",
      "markerWidth": 5,
      "libraries": ["docsluice", "officeparser", "mammoth"]
    },
    {
      "format": "xlsx",
      "fixture": "benchmark-50000-rows.xlsx",
      "expectedUnits": 50000,
      "marker": "(?<![A-Za-z0-9])R[0-9]{5}(?![A-Za-z0-9])",
      "markerPrefix": "R",
      "markerWidth": 5,
      "libraries": ["docsluice", "officeparser", "xlsx"]
    },
    {
      "format": "pdf",
      "fixture": "benchmark-100-pages.pdf",
      "expectedUnits": 100,
      "marker": "(?<![A-Za-z0-9])PAGE-[0-9]{3}(?![A-Za-z0-9])",
      "markerPrefix": "PAGE-",
      "markerWidth": 3,
      "libraries": ["docsluice", "officeparser", "pdf-parse", "unpdf", "pdfjs-dist"]
    }
