      "formats": ["docx", "xlsx", "pdf"]
    },
    "officeparser": {
      "package": "officeparser",
      "version": "8.1.1",
      "license": "MIT",
      "source": "https://github.com/harshankur/officeParser",
      "formats": ["docx", "xlsx", "pdf"]
    },
    "mammoth": {
      "package": "mammoth",
