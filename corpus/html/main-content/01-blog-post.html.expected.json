{"format":"html","mimeType":"text/html","encoding":"utf-8","metadata":{},"features":{"hasMacros":false,"hasExternalLinks":false,"hasEmbeddedFiles":false,"isEncrypted":false,"hasJavaScript":false},"blocks":[{"kind":"paragraph","text":"Field Notes","loc":{"offset":[0,11]}},{"kind":"paragraph","text":"Home Archive About","loc":{"offset":[13,31]}},{"kind":"heading","level":1,"text":"Counting anemones at low tide","loc":{"offset":[33,62]}},{"kind":"paragraph","text":"By the survey team, 14 May 2026","loc":{"offset":[64,95]}},{"kind":"paragraph","text":"We counted green anemones along three transects at the north inlet during the lowest tide of the month.","loc":{"offset":[97,200]}},{"kind":"paragraph","text":"Cover was highest on the sheltered side of the boulder field, where the water stays in shallow pools for hours.","loc":{"offset":[202,313]}},{"kind":"heading","level":2,"text":"Method","loc":{"offset":[315,321]}},{"kind":"paragraph","text":"Each transect was walked twice, and every anemone wider than two centimetres was recorded with its pool number.","loc":{"offset":[323,434]}},{"kind":"paragraph","text":"Filed under ecology and surveys.","loc":{"offset":[436,468]}},{"kind":"heading","level":2,"text":"Comments","loc":{"offset":[470,478]}},{"kind":"paragraph","text":"Great post! Can we join the next count? Reader comment text.","loc":{"offset":[480,540]}},{"kind":"heading","level":2,"text":"Popular posts","loc":{"offset":[542,555]}},{"kind":"list","ordered":false,"items":[{"text":"Barnacles of the outer bank"},{"text":"A year of kelp"}],"loc":{"offset":[557,603]}},{"kind":"paragraph","text":"Copyright notice for the field notes site, all rights reserved.","loc":{"offset":[605,668]}}],"children":[],"warnings":[],"stats":{"bytesRead":1240,"durationMs":0,"truncated":false,"needsOcr":false}}