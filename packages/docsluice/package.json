{
  "name": "docsluice",
  "version": "0.0.0",
  "description": "Safe, structured document extraction for every JavaScript runtime. One call, one result shape, limits on by default.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "node": [
        "dist/node/index.d.ts"
      ],
      "doc": [
        "dist/doc.d.ts"
      ],
      "txt": [
        "dist/txt.d.ts"
      ],
      "markdown": [
        "dist/markdown.d.ts"
      ],
      "csv": [
        "dist/csv.d.ts"
      ],
      "tsv": [
        "dist/tsv.d.ts"
      ],
      "json": [
        "dist/json.d.ts"
      ],
      "xml": [
        "dist/xml.d.ts"
      ],
      "html": [
        "dist/html.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.cjs"
    },
    "./doc": {
      "import": "./dist/doc.js",
      "require": "./dist/doc.cjs"
    },
    "./txt": {
      "import": "./dist/txt.js",
      "require": "./dist/txt.cjs"
    },
    "./markdown": {
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./csv": {
      "import": "./dist/csv.js",
      "require": "./dist/csv.cjs"
    },
    "./tsv": {
      "import": "./dist/tsv.js",
      "require": "./dist/tsv.cjs"
    },
    "./json": {
      "import": "./dist/json.js",
      "require": "./dist/json.cjs"
    },
    "./xml": {
      "import": "./dist/xml.js",
      "require": "./dist/xml.cjs"
    },
    "./html": {
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/node/tsconfig.json && tsc -p test/node/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "node ../../scripts/check-deps.test.mjs && node ../../scripts/check-deps.mjs && publint . && attw --pack . && size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "50 KB",
      "gzip": true
    }
  ],
  "keywords": [
    "document",
    "extraction",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "markdown",
    "rag",
    "llm",
    "parser"
  ],
  "dependencies": {
    "fflate": "0.8.2"
  }
}
