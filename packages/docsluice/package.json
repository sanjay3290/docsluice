{
  "name": "docsluice",
  "version": "0.0.0",
  "description": "Safe, structured document extraction for every JavaScript runtime. One call, one result shape, limits on by default.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "node": [
        "dist/node/index.d.ts"
      ],
      "worker": [
        "dist/worker.d.ts"
      ],
      "doc": [
        "dist/doc.d.ts"
      ],
      "txt": [
        "dist/txt.d.ts"
      ],
      "markdown": [
        "dist/markdown.d.ts"
      ],
      "csv": [
        "dist/csv.d.ts"
      ],
      "tsv": [
        "dist/tsv.d.ts"
      ],
      "json": [
        "dist/json.d.ts"
      ],
      "xml": [
        "dist/xml.d.ts"
      ],
      "html": [
        "dist/html.d.ts"
      ],
      "rtf": [
        "dist/rtf.d.ts"
      ],
      "docx": [
        "dist/docx.d.ts"
      ],
      "xlsx": [
        "dist/xlsx.d.ts"
      ],
      "xls": [
        "dist/xls.d.ts"
      ],
      "pptx": [
        "dist/pptx.d.ts"
      ],
      "odt": [
        "dist/odt.d.ts"
      ],
      "ods": [
        "dist/ods.d.ts"
      ],
      "zip": [
        "dist/zip.d.ts"
      ],
      "gzip": [
        "dist/gzip.d.ts"
      ],
      "tar": [
        "dist/tar.d.ts"
      ],
      "eml": [
        "dist/eml.d.ts"
      ],
      "msg": [
        "dist/msg.d.ts"
      ],
      "epub": [
        "dist/epub.d.ts"
      ]
    }
  },
  "bin": {
    "docsluice": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.cjs"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./doc": {
      "import": "./dist/doc.js",
      "require": "./dist/doc.cjs"
    },
    "./txt": {
      "import": "./dist/txt.js",
      "require": "./dist/txt.cjs"
    },
    "./markdown": {
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./csv": {
      "import": "./dist/csv.js",
      "require": "./dist/csv.cjs"
    },
    "./tsv": {
      "import": "./dist/tsv.js",
      "require": "./dist/tsv.cjs"
    },
    "./json": {
      "import": "./dist/json.js",
      "require": "./dist/json.cjs"
    },
    "./xml": {
      "import": "./dist/xml.js",
      "require": "./dist/xml.cjs"
    },
    "./html": {
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./rtf": {
      "import": "./dist/rtf.js",
      "require": "./dist/rtf.cjs"
    },
    "./docx": {
      "import": "./dist/docx.js",
      "require": "./dist/docx.cjs"
    },
    "./xlsx": {
      "import": "./dist/xlsx.js",
      "require": "./dist/xlsx.cjs"
    },
    "./xls": {
      "import": "./dist/xls.js",
      "require": "./dist/xls.cjs"
    },
    "./pptx": {
      "import": "./dist/pptx.js",
      "require": "./dist/pptx.cjs"
    },
    "./odt": {
      "import": "./dist/odt.js",
      "require": "./dist/odt.cjs"
    },
    "./ods": {
      "import": "./dist/ods.js",
      "require": "./dist/ods.cjs"
    },
    "./zip": {
      "import": "./dist/zip.js",
      "require": "./dist/zip.cjs"
    },
    "./gzip": {
      "import": "./dist/gzip.js",
      "require": "./dist/gzip.cjs"
    },
    "./tar": {
      "import": "./dist/tar.js",
      "require": "./dist/tar.cjs"
    },
    "./eml": {
      "import": "./dist/eml.js",
      "require": "./dist/eml.cjs"
    },
    "./msg": {
      "import": "./dist/msg.js",
      "require": "./dist/msg.cjs"
    },
    "./epub": {
      "import": "./dist/epub.js",
      "require": "./dist/epub.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/node/tsconfig.json && tsc -p test/node/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "node ../../scripts/check-deps.test.mjs && node ../../scripts/check-deps.mjs && publint . && attw --pack . && size-limit"
  },
  "keywords": [
    "document",
    "extraction",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "markdown",
    "rag",
    "llm",
    "parser"
  ],
  "dependencies": {
    "fflate": "0.8.2"
  }
}
