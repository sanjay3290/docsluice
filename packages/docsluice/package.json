  "scripts": {
    "build": "tsdown && node scripts/generate-schema.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/node/tsconfig.json && tsc -p test/node/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "node ../../scripts/check-deps.test.mjs && node ../../scripts/check-deps.mjs && publint . && attw --pack . && size-limit"
  },
