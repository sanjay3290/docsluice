{
  "name": "docsluice",
  "version": "0.0.0",
  "description": "Safe, structured document extraction for every JavaScript runtime. One call, one result shape, limits on by default.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "node": [
        "dist/node/index.d.ts"
      ],
      "doc": [
        "dist/doc.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.cjs"
    },
    "./doc": {
      "import": "./dist/doc.js",
      "require": "./dist/doc.cjs"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "schema:generate": "node scripts/generate-schema.mjs",
    "build": "npm run schema:generate && tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/node/tsconfig.json",
    "test": "npm run schema:generate && vitest run",
    "test:watch": "vitest",
    "coverage": "npm run schema:generate && vitest run --coverage",
    "check:package": "node ../../scripts/check-deps.test.mjs && node ../../scripts/check-deps.mjs && publint . && attw --pack . && size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "50 KB",
      "gzip": true
    }
  ],
  "keywords": [
    "document",
    "extraction",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "markdown",
    "rag",
    "llm",
    "parser"
  ],
  "dependencies": {
    "fflate": "0.8.3"
  }
}
