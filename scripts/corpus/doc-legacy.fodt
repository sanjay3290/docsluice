<?xml version="1.0" encoding="UTF-8"?>
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">
  <office:body><office:text>
    <text:h text:outline-level="1">Legacy Word fixture</text:h>
    <text:p>Paragraph with café, €12, and a visible field result: July 4, 2026.</text:p>
    <text:h text:outline-level="2">Second heading</text:h>
    <table:table table:name="Inventory">
      <table:table-column table:number-columns-repeated="2"/>
      <table:table-row>
        <table:table-cell office:value-type="string"><text:p>Item</text:p></table:table-cell>
        <table:table-cell office:value-type="string"><text:p>Count</text:p></table:table-cell>
      </table:table-row>
      <table:table-row>
        <table:table-cell office:value-type="string"><text:p>Paper</text:p></table:table-cell>
        <table:table-cell office:value-type="string"><text:p>3</text:p></table:table-cell>
      </table:table-row>
    </table:table>
    <text:p>Final paragraph for text recall.</text:p>
  </office:text></office:body>
</office:document>
