<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:officeooo="http://openoffice.org/2009/office" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text"><office:automatic-styles></office:automatic-styles><office:body><office:text><text:h text:outline-level="1">Marsh Transect Diagram</text:h><text:p>Open <text:a xlink:type="simple" xlink:href="https://example.invalid/methods/transect">the transect protocol</text:a> for method details.</text:p><text:p><draw:frame draw:name="tiny-alt-image" text:anchor-type="as-char" svg:width="0.1in" svg:height="0.1in"><svg:title>Green sampling marker</svg:title><svg:desc>A tiny green marker representing the sampling point.</svg:desc><draw:image draw:mime-type="image/png"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNQOODwHwAERAIgypllwgAAAABJRU5ErkJggg==</office:binary-data></draw:image></draw:frame></text:p><text:p>Image follows the site description.</text:p></office:text></office:body></office:document>